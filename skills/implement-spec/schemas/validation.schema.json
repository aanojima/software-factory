{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_satisfied", "acceptance_criteria", "deterministic_checks", "regressions", "limitations"],
  "properties": {
    "goal_satisfied": {"type": "boolean"},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "unverified"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not_run"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "regressions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
