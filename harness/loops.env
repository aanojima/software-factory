PLAN_LOOP_CAP=3
PLAN_LOOP_CAP_T2=5        # HEAVY plan + independent-critic loop — looser than T1
                          # since Fable 5.1's 75%-cheaper cache reads make replanning
                          # against the same cached repo-context prefix cheap
REVIEW_LOOP_CAP=2         # T1/STANDARD review panel
REVIEW_LOOP_CAP_T2=3      # T2/HEAVY review panel — more reviewers, one extra pass
TEST_LOOP_CAP=3
RALPH_MAX_ITER=25
CEREMONY_CEILING=0.15
TRIAGE_MODEL=claude-haiku-4-5
CODEX_TRIAGE_MODEL=gpt-5.4-mini
EXEC_MODEL=claude-sonnet-5        # cheap default; ladder up only via Stage 5
CODEX_EXEC_MODEL=gpt-5.6-luna
CODEX_EXEC_EFFORT=max
CODEX_EXPLORER_MODEL=gpt-5.6-luna
CODEX_EXPLORER_EFFORT=low
CODEX_PLAN_CRITIC_MODEL=gpt-6-astra
CODEX_PLAN_CRITIC_EFFORT=high
CODEX_VERIFIER_MODEL=gpt-5.6-luna
CODEX_VERIFIER_EFFORT=high
CODEX_REVIEW_MODEL=gpt-5.6-sol
CODEX_REVIEW_EFFORT=high
CODEX_PONYTAIL_MODEL=gpt-5.6-luna
CODEX_PONYTAIL_EFFORT=low
CODEX_PR_INTAKE_MODEL=gpt-5.6-luna
CODEX_PR_INTAKE_EFFORT=low
PR_WATCH_LOOP_CAP=5               # max escalations dispatched per PR watch
PR_WATCH_TIMEOUT_MIN=180          # stop and report after this long
PR_WATCH_POLL_INTERVAL_SEC=60     # --interval passed to `gh pr-monitor`; it paces its
                                  # own GitHub polling, pr-intake reacts event-driven
BULK_READ_LINE_THRESHOLD=350      # Read/cat/less/more over this many lines is blocked
                                  # by hooks/scripts/check-file-size.sh and
                                  # check-bash-read.sh; the model must delegate to the
                                  # bulk-read skill instead of paying full context price
BULK_READ_MODEL=claude-haiku-4-5  # cheap worker model for the bulk-reader agent
                                  # check-bash-output.sh (PostToolUse on Bash) reuses
                                  # BULK_READ_LINE_THRESHOLD: any Bash result over that
                                  # many lines gets a nudge toward bulk-read, whatever
                                  # command produced it (python heredoc, sed -n, awk...)
PROTECTED_WRITE_PATTERNS='^tasks/done/|^eval/golden\.jsonl$|(^|/)tests?/|(^|/)__tests__/|[._-](test|spec)\.[a-z]+$|^test_[^/]+\.py$|(^|/)conftest\.py$'
                                  # '|'-separated extended regexes, matched against the
                                  # repo-relative path. check-protected-write.sh denies
                                  # Edit/Write/MultiEdit/NotebookEdit on a match, and
                                  # write-shaped Bash (redirect, tee, sed -i, heredoc...)
                                  # naming one. SF_ALLOW_PROTECTED_WRITE=1 bypasses.
WEB_FETCH_CHAR_THRESHOLD=8000     # a WebFetch result over this many characters trips a
                                  # PostToolUse nudge (check-web-fetch-size.sh) toward the
                                  # web-fetch skill's web-reader worker on the next call —
                                  # this is the after-the-fact fallback for whatever the
                                  # precheck below doesn't catch
WEB_FETCH_PRECHECK_BYTES=8000     # check-web-fetch-precheck.sh (PreToolUse) curls the URL
                                  # itself, capped at WEB_FETCH_PRECHECK_READ_CAP bytes, and
                                  # blocks the WebFetch call outright if that read already
                                  # exceeds this many bytes; a failed/timed-out curl always
                                  # fails open (allows the call) rather than guessing
WEB_FETCH_PRECHECK_READ_CAP=50000 # max bytes the precheck itself downloads before giving up
                                  # and counting what it has — never pulls a whole huge file
WEB_FETCH_PRECHECK_TIMEOUT_SEC=10 # curl --max-time for the precheck
WEB_FETCH_MODEL=claude-haiku-4-5  # cheap worker model for the web-reader agent
